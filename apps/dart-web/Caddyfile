{
	admin off
	persist_config off
}

:80 {
	root * /srv
	encode gzip

	@immutable {
		path /_next/static/*
		file
	}
	@rebuilt_on_deploy not {
		path /_next/static/*
		file
	}

	header @rebuilt_on_deploy Cache-Control "no-cache"
	header @immutable Cache-Control "public, max-age=31536000, immutable"

	try_files {path} {path}.html
	file_server

	handle_errors 404 {
		rewrite * /404.html
		file_server
	}
}
