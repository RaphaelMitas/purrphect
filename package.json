{
  "name": "purrphect",
  "private": true,
  "license": "MIT",
  "packageManager": "pnpm@11.28.11",
  "scripts": {
    "dev": "turbo run dev",
    "ios": "pnpm --filter @purrphect/dart ios",
    "android": "pnpm --filter @purrphect/dart android",
    "check": "biome check",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "lint:ws": "sherif",
    "lint:store": "node scripts/check-store-text.mjs",
    "verify": "pnpm check && pnpm lint:ws && pnpm lint:store && pnpm typecheck && pnpm test && turbo run build --filter @purrphect/dart-web",
    "verify:e2e": "pnpm verify && bash tooling/e2e/run.sh",
    "op": "op run --no-masking --environment wqa7rtun5ra2rlna54gukuwguu --",
    "op-prod": "op run --no-masking --environment 5ewszd5julkpo5yqszdobp27i4 --",
    "release": "node scripts/release.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "catalog:",
    "sherif": "^1.13.0",
    "turbo": "^2.11.11",
    "typescript": "catalog:"
  }
}
